          <onRightFast />
        </encoder>
        <preconditions />
        <configrefs>
          <configref active="True" ref="ecf448ea-76f9-443c-9d61-6fe299f8ec4b" placeholder="#" testvalue="1" />
          <configref active="True" ref="e9e6c105-29ec-46ac-8e6b-ed424508c3fc" placeholder="Q" testvalue="1" />
